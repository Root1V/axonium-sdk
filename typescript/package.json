{
  "name": "axonium",
  "version": "0.2.4",
  "description": "TypeScript SDK for the Prometheus inference platform",
  "license": "MIT",
  "author": "Emeric Espiritu Santiago",
  "homepage": "https://root1v.github.io/axonium-sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Root1V/axonium-sdk.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/Root1V/axonium-sdk/issues",
  "keywords": [
    "llm",
    "inference",
    "prometheus-gateway",
    "openai-compatible",
    "sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/rename-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "lint": "prettier --check src test scripts examples docs && tsc -p tsconfig.json --noEmit && npm run --silent typecheck:examples",
    "format": "prettier --write src test scripts examples docs",
    "test:integration": "node --test --test-timeout=120000 --experimental-strip-types test/integration/*.test.ts",
    "typecheck:examples": "npm run --silent build && tsc -p tsconfig.examples.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.3.0",
    "typescript": "^5.9.3"
  }
}
